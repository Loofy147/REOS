# Select two distinct provider-prefixed model identifiers.
# Example pair: OpenAI analysis + Anthropic independent review.
ATHENA_ANALYSIS_MODEL=openai:<analysis-model>
ATHENA_REVIEW_MODEL=anthropic:<review-model>

# Set credentials only for the providers used above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini alternative: ATHENA_REVIEW_MODEL=google_genai:<model>
GOOGLE_API_KEY=

# Persistent SQLite checkpoint database.
ATHENA_DB_PATH=./data/athena.sqlite

# Optional LangSmith tracing. Traces may include prompts and outputs.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=athena-development
